# Use this only when running the Next.js app directly with npm on the host machine.
# Docker Compose sets DATABASE_URL for the app container automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketsync

# Used for password reset and email verification flows.
APP_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
